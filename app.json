{
  "expo": {
    "name": "WORKIT",
    "slug": "workit",
    "scheme": "workit",
    "version": "0.1.0",
    "orientation": "portrait",
    "backgroundColor": "#05070A",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.workit.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.workit.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#8B5CF6"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WORKIT to access photos and videos you choose for your professional profile and work."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification.png",
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070A",
          "image": "./assets/brand/splash.png",
          "imageWidth": 128
        }
      ],
      "expo-video"
    ],
    "icon": "./assets/brand/icon.png"
  }
}
